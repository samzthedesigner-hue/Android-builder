# Server Configuration
PORT=3000
NODE_ENV=production

# Build Configuration
MAX_CODE_SIZE=100000
BUILD_TIMEOUT=120000
CLEANUP_ON_EXIT=true

# Tool Paths (optional - auto-detected)
# JAVA_HOME=/usr/lib/jvm/java-17
# ANDROID_SDK_ROOT=/opt/android-sdk

# Download URLs (optional - override defaults)
# ANDROID_JAR_URL=https://storage.googleapis.com/android-sdk/platforms/android-34/android.jar
